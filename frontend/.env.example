# ========================================================
# Configuración de Entorno Frontend - AQP-SOLIDARIA
# ========================================================

# Flag para mocks controlados (true para desarrollo local/pruebas, false para conectar a AWS)
VITE_USE_MOCK=true

# URL base del API Gateway HTTP API desplegado en AWS (ej. https://abc123xyz.execute-api.us-east-1.amazonaws.com/academic)
VITE_API_BASE_URL=

# Configuración de Amazon Cognito (Authorization Code + PKCE)
VITE_COGNITO_USER_POOL_ID=us-east-1_example123
VITE_COGNITO_CLIENT_ID=exampleappclientid12345
VITE_COGNITO_DOMAIN=https://aqp-solidaria-users.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

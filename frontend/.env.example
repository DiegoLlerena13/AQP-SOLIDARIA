# ========================================================
# Configuración de Entorno Frontend - AQP-SOLIDARIA
# ========================================================
# Copiar este archivo a .env y ajustar los valores locales.
# El archivo .env NO se sube a git (ver .gitignore).

# Modo: true = mocks locales (por defecto, seguro para CI y compañeros sin AWS)
#        false = conectar a AWS real (requiere valores reales abajo)
VITE_USE_MOCK=true

# API Gateway HTTP API - Región us-east-2 (Ohio)
# Endpoint real del líder — solo funciona con VITE_USE_MOCK=false
VITE_API_BASE_URL=https://r3hrmkrkkf.execute-api.us-east-2.amazonaws.com/academic

# Amazon Cognito (Authorization Code + PKCE) - us-east-2 (Ohio)
# User Pool y App Client configurados por el líder del equipo
VITE_COGNITO_USER_POOL_ID=us-east-2_DH2KMafTU
VITE_COGNITO_CLIENT_ID=7ft2f51iags0qnirve0vocq5s9
VITE_COGNITO_DOMAIN=https://us-east-2dh2kmaftu.auth.us-east-2.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
